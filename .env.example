# Investment Experts — Environment Variable Template
# Copy this file to .env.local for local development
# NEVER commit .env.local or .env.production to version control
# See docs/BLOCKERS.md for credential provisioning status

##############################################
# APPLICATION
##############################################
APP_ENV=development
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
BUILD_SHA=local
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=AED

##############################################
# DATABASE (Supabase/PostgreSQL)
##############################################
# BLOCKER-001: Requires Supabase project provisioning
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_POOL_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=[ANON_KEY]
SUPABASE_SECRET_KEY=[SERVICE_ROLE_KEY]

##############################################
# SEARCH (Typesense)
##############################################
# BLOCKER-001: Requires Typesense instance provisioning
TYPESENSE_HOST=https://[INSTANCE_ID].a1.typesense.net
TYPESENSE_SEARCH_KEY=[SEARCH_ONLY_KEY]
TYPESENSE_ADMIN_KEY=[ADMIN_KEY]
SEARCH_SCHEMA_VERSION=1.0.0

##############################################
# REDIS / QUEUE
##############################################
# BLOCKER-001: Requires Redis instance provisioning
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=investment-experts
WORKER_CONCURRENCY=4

##############################################
# AI (OpenAI)
##############################################
# BLOCKER-001: Requires OpenAI API key
OPENAI_API_KEY=sk-[YOUR_API_KEY]
AI_MODEL_DEFAULT=gpt-4o-mini
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_DAILY_BUDGET_MINOR=10.00

##############################################
# MAPS (Mapbox)
##############################################
# BLOCKER-001: Requires Mapbox account
MAPBOX_PUBLIC_TOKEN=pk.[YOUR_TOKEN]
MAPBOX_SECRET_TOKEN.sk.[YOUR_SECRET_TOKEN]

##############################################
# CRM INTEGRATION
##############################################
# BLOCKER-002: Requires CRM vendor selection and credentials
CRM_PROVIDER=hubspot
CRM_BASE_URL=https://api.hubapi.com
CRM_CLIENT_ID=[CLIENT_ID]
CRM_CLIENT_SECRET=[CLIENT_SECRET]
CRM_WEBHOOK_SECRET=[WEBHOOK_SECRET]

##############################################
# EMAIL
##############################################
# BLOCKER-001: Requires email provider setup
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.[YOUR_API_KEY]
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_WEBHOOK_SECRET=[WEBHOOK_SECRET]

##############################################
# ANALYTICS
##############################################
# BLOCKER-001: Requires analytics account setup
GA_MEASUREMENT_ID=G-[MEASUREMENT_ID]
PRODUCT_ANALYTICS_KEY=[POSTHOG_KEY]
ANALYTICS_SERVER_SECRET=[SERVER_SECRET]

##############################################
# OBSERVABILITY
##############################################
# BLOCKER-001: Requires observability service setup
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
ERROR_TRACKING_DSN=https://[KEY]@o[ORG].ingest.sentry.io/[PROJECT]
LOG_LEVEL=info

##############################################
# SECURITY
##############################################
# CRITICAL: Generate secure random values for production
# Never use these example values in production
APP_ENCRYPTION_KEY=[32_BYTE_HEX_KEY]
CRON_SECRET=[RANDOM_SECRET]
WEBHOOK_REPLAY_WINDOW_SECONDS=300

##############################################
# DEVELOPMENT FLAGS
##############################################
# Safe to modify for local development
ENABLE_MOCK_CRM=false
ENABLE_MOCK_SEARCH=false
ENABLE_MOCK_AI=false
ENABLE_MOCK_MAPS=false
